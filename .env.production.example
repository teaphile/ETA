# =============================================================================
# Exam Travel Assist — PRODUCTION environment template
# -----------------------------------------------------------------------------
# Copy to `.env` on the server and fill in real values. NEVER commit this file.
#   cp .env.production.example .env && php artisan key:generate
# =============================================================================

APP_NAME="Exam Travel Assist"
APP_ENV=production
APP_KEY=                       # generated by: php artisan key:generate
APP_DEBUG=false                # MUST be false in production
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Database (MySQL 8) ------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=examtravel
DB_USERNAME=exam
DB_PASSWORD=change-me

# --- Sessions / cache / queue ------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- HTTPS behind a proxy / load balancer ------------------------------------
# Comma-separated list of trusted proxy IPs. Use the proxy's address, not "*".
TRUSTED_PROXIES=127.0.0.1

# --- Mail (required for password reset & optional verification) ---------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Exam Travel Assist integrations (all optional; app runs keyless) ---------
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_PLACES_SERVER_KEY=
GOOGLE_MAPS_REGION=IN
GOOGLE_MAPS_LANGUAGE=en

PLACES_PROVIDER=curated

AI_PROVIDER=faq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

TRANSPORT_PROVIDER=estimate
TRANSPORT_API_KEY=
TRANSPORT_API_BASE_URL=

NOTIFICATION_PROVIDER=mail

# --- Behaviour ---------------------------------------------------------------
# Turn on ONLY after mail delivery is confirmed working.
REQUIRE_EMAIL_VERIFICATION=false
SUPPORT_EMAIL=support@your-domain.example

# --- Retention & freshness ---------------------------------------------------
CENTRE_FRESHNESS_MONTHS=6
SERVICE_FRESHNESS_MONTHS=6
CHAT_RETENTION_DAYS=90
SEARCH_LOG_RETENTION_DAYS=180
INTEGRATION_EVENT_RETENTION_DAYS=90
ACCOUNT_DELETION_GRACE_DAYS=30
IMPORT_ROW_RETENTION_DAYS=365

# Demo seeder guard. Leave false in production.
ALLOW_DEMO_SEED=false
