APP_NAME="Exam Travel Assist"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true in production (HTTPS only) so the session cookie is never sent in clear.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Exam Travel Assist integrations (all optional; the app degrades gracefully) ---
#
# Mapping / GIS (Google Maps Platform). Restricted keys only; never a billable
# unrestricted key. See docs/API_SETUP.md.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_REGION=IN
GOOGLE_MAPS_LANGUAGE=en

# Nearby-place search. curated = administrator-maintained listings (always works);
# google = Google Places API (needs GOOGLE_PLACES_SERVER_KEY).
PLACES_PROVIDER=curated
GOOGLE_PLACES_SERVER_KEY=

# AI assistant. faq = grounded database/FAQ answers only (no external call);
# openai = an OpenAI-compatible endpoint used to phrase grounded answers.
AI_PROVIDER=faq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Transport data. estimate = disclosed distance-based planning ranges + official
# booking links (default). A live provider requires a licensed partner API.
TRANSPORT_PROVIDER=estimate
TRANSPORT_API_KEY=
TRANSPORT_API_BASE_URL=

# Transactional notifications. mail = send via MAIL_*; log = write to the log.
NOTIFICATION_PROVIDER=mail

# Email verification for student features. Off by default so students can search
# and plan immediately; turn on once MAIL_* is configured.
REQUIRE_EMAIL_VERIFICATION=false

# --- Retention & freshness (used by scheduled maintenance commands) ---
CENTRE_FRESHNESS_MONTHS=6
SERVICE_FRESHNESS_MONTHS=6
CHAT_RETENTION_DAYS=90
SEARCH_LOG_RETENTION_DAYS=180
INTEGRATION_EVENT_RETENTION_DAYS=90
ACCOUNT_DELETION_GRACE_DAYS=30
IMPORT_ROW_RETENTION_DAYS=365

# Demo data guard. The demo seeder refuses to run in production unless this is true.
ALLOW_DEMO_SEED=false

# Comma-separated list of trusted reverse-proxy addresses (X-Forwarded-*).
TRUSTED_PROXIES=127.0.0.1,::1
SUPPORT_EMAIL=support@example.com

